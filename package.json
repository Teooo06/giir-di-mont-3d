{
  "name": "giir-di-mont-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-menu.js",
    "dev:web": "vite --host",
    "dev:ndi": "node server/ndi-service.js",
    "dev:dji": "node server/dji-bridge.js",
    "dev:dji:debug": "node server/dji-bridge.js --debug",
    "dev:all": "concurrently -n \"VITE,NDI,DJI\" -c \"cyan,magenta,yellow\" \"vite --host\" \"node server/ndi-service.js\" \"node server/dji-bridge.js\"",
    "build": "vite build",
    "preview": "vite preview",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:list": "playwright test --list"
  },
  "dependencies": {
    "grandi": "^2.0.2",
    "serialport": "^12.0.0",
    "three": "^0.180.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "vite": "^7.0.0"
  }
}
